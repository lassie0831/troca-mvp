# Copy to .env and adjust. Every variable is validated at startup (src/config/env.ts).

NODE_ENV=development
PORT=3000
# Optional public URL of the API, used to build absolute photo URLs with the local storage driver.
# Leave it unset in development: URLs become relative (/uploads/...) and the app resolves them.
# API_PUBLIC_URL=https://api.example.com
CORS_ORIGINS=*
TRUST_PROXY=0

DATABASE_URL=postgres://troca:troca@localhost:5432/troca
DATABASE_POOL_MAX=10
DATABASE_SSL=false
MIGRATE_ON_START=true

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# local = disk + served by the API at /uploads (dev only) | s3 = any S3-compatible storage
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads
# S3 / Cloudflare R2 / MinIO
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=troca-photos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# Optional CDN / public bucket domain; without it, presigned URLs (1 h) are returned.
# STORAGE_PUBLIC_BASE_URL=https://photos.example.com

# Business rules
PRICE_TOLERANCE_PCT=20
FEED_MAX_RADIUS_KM=50
LOCATION_FUZZ_MIN_M=200
LOCATION_FUZZ_MAX_M=1000
LOCATION_ANCHOR_REUSE_M=500
MAX_PHOTOS_PER_ITEM=6
