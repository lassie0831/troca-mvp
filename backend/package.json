{
  "name": "troca-api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST do marketplace P2P de trocas (MVP)",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "node scripts/dev.mjs",
    "migrate": "node --env-file-if-exists=.env dist/database/migrate.cli.js",
    "seed": "node --env-file-if-exists=.env dist/database/seed.cli.js",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test \".test-dist/test/unit/**/*.test.js\"",
    "pretest:e2e": "tsc -p tsconfig.test.json",
    "test:e2e": "node --env-file-if-exists=.env.test --test --test-concurrency=1 \".test-dist/test/e2e/**/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/throttler": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
